#!/usr/bin/env python3
# RLW2026
"""
korus

End-to-end ancestry inference pipeline.

Pipeline:
korusEncode
->
korusDecode.py
->
plot_ntroot_lai.py
->
HTML report

Intended for single-sample analysis.

Advanced users should use korusEncode and korusDecode.py
directly.
"""

import argparse
import os
import shlex
import subprocess
import pandas as pd
import shutil
import re


KORUS_VERSION = "v1.1.0"

#-----------------------------
def set_up_parser():

    parser = argparse.ArgumentParser(
        description="End-to-end KORUS ancestry inference pipeline"
    )

    # --------------------------------------------------
    # Encode options
    # --------------------------------------------------

    parser.add_argument(
        "--reads",
        required=True,
        help="Input read prefix"
    )

    parser.add_argument(
        "--report_mode",
        choices=["iframe", "embed"],
        default="iframe",
        help="Report layout mode [default=iframe]"
    )

    parser.add_argument(
        "--kmer_file",
        required=True,
        help="SNV k-mer definition file"
    )

    parser.add_argument(
        "-k",
        required=True,
        type=int,
        choices=[45, 55],
        help="Model k-mer size"
    )

    parser.add_argument(
        "--tile",
        default=500000,
        type=int
    )

    parser.add_argument(
        "-t",
        default=48,
        type=int
    )

    # --------------------------------------------------
    # Decode options
    # --------------------------------------------------

    parser.add_argument(
        "--mode",
        choices=["hard", "soft", "unsupervised"],
        default="hard"
    )

    parser.add_argument(
        "--c",
        type=int,
        default=None,
        help="KMeans n_clusters (unsupervised mode)"
    )

    parser.add_argument(
        "--global_pcs",
        type=int,
        default=10,
        help="Number of PCs used for unsupervised K-means clustering"
    )

    parser.add_argument(
        "--local_pcs",
        type=int,
        default=10,
        help="Maximum number of PCs used for local Mahalanobis ancestry inference"
    )

    parser.add_argument(
        "--window_radius",
        type=int,
        default=None
    )

    parser.add_argument(
        "--stay_prob",
        type=float,
        default=None
    )

    parser.add_argument(
        "--no_hmm",
        action="store_true"
    )

    parser.add_argument(
        "--outprefix",
        required=True
    )

    parser.add_argument(
        "--report_title",
        default="KORUS Ancestry Predictions"
    )

    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true"
    )

    parser.add_argument(
        "-V",
        "--version",
        action="version",
        version=KORUS_VERSION
    )

    parser.add_argument(
        "--ref",
        help="Override bundled reference matrix"
    )

    parser.add_argument(
        "--labels",
        help="Override bundled hard-supervised labels"
    )

    parser.add_argument(
        "--fractions",
        help="Override bundled soft-supervised fractions"
    )

    return parser

#-----------------------------
def run_command(cmd, dry_run=False):

    print(f"\nRunning:\n{cmd}\n", flush=True)

    if dry_run:
        return

    ret = subprocess.call(shlex.split(cmd))

    if ret != 0:
        raise RuntimeError(
            f"Command failed:\n{cmd}"
        )

#-----------------------------
def extract_plotly_fragment(html_file):

    with open(html_file) as fh:
        text = fh.read()

    body = re.search(
        r"<body[^>]*>(.*)</body>",
        text,
        flags=re.S | re.I
    )

    if body:
        text = body.group(1)

    text = re.sub(
        r'<script[^>]*plotly[^>]*></script>',
        '',
        text,
        flags=re.S | re.I
    )

    return text

