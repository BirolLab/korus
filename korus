#!/usr/bin/env python3

"""
korus

End-to-end ancestry inference pipeline.

Pipeline:
korusEncode
->
korusDecode.py
->
plot_ntroot_lai.py
->
HTML report

Intended for single-sample analysis.

Advanced users should use korusEncode and korusDecode.py
directly.
"""

import argparse
import glob
import os
import shlex
import subprocess
import sys
import pandas as pd
import shutil

KORUS_VERSION = "v0.1.1"

def set_up_parser():

    parser = argparse.ArgumentParser(
        description="End-to-end KORUS ancestry inference pipeline"
    )

    # --------------------------------------------------
    # Encode options
    # --------------------------------------------------

    parser.add_argument(
        "--reads",
        required=True,
        help="Input read prefix"
    )

    parser.add_argument(
        "--kmer_file",
        required=True,
        help="SNV k-mer definition file"
    )

    parser.add_argument(
        "-k",
        required=True,
        type=int,
        choices=[45, 55],
        help="Model k-mer size"
    )

    parser.add_argument(
        "--tile",
        default=500000,
        type=int
    )

    parser.add_argument(
        "-t",
        default=48,
        type=int
    )

    # --------------------------------------------------
    # Decode options
    # --------------------------------------------------

    parser.add_argument(
        "--mode",
        choices=["hard", "soft", "unsupervised"],
        default="hard"
    )

    parser.add_argument(
        "--c",
        type=int,
        default=5,
        help="KMeans n_clusters (unsupervised mode)"
    )

    parser.add_argument(
        "--window_radius",
        default=5,
        type=int
    )

    parser.add_argument(
        "--stay_prob",
        default=0.95,
        type=float
    )

    parser.add_argument(
        "--no_hmm",
        action="store_true"
    )

    parser.add_argument(
        "--outprefix",
        required=True
    )

    parser.add_argument(
        "--report_title",
        default="KORUS Analysis Report"
    )

    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true"
    )

    parser.add_argument(
        "-V",
        "--version",
        action="version",
        version=KORUS_VERSION
    )

    parser.add_argument(
        "--ref",
        help="Override bundled reference matrix"
    )

    parser.add_argument(
        "--labels",
        help="Override bundled hard-supervised labels"
    )

    parser.add_argument(
        "--fractions",
        help="Override bundled soft-supervised fractions"
    )

    return parser


def run_command(cmd, dry_run=False):

    print(f"\nRunning:\n{cmd}\n", flush=True)

    if dry_run:
        return

    ret = subprocess.call(shlex.split(cmd))

    if ret != 0:
        raise RuntimeError(
            f"Command failed:\n{cmd}"
        )

def write_report(outprefix, title, pca_html, lai_html):

    report_file = f"{outprefix}.report.html"

    html = """
<html>
<style>
body {{
    font-family: Arial, sans-serif;
    margin: 20px;
}}
iframe {{
    width: 100%;
    border: none;
}}
</style>

<head>
<title>{title}</title>
</head>

<body>

<h1>{title}</h1>

<iframe src="{pca_html}" height="900"></iframe>

<iframe src="{lai_html}" height="1200"></iframe>

</body>
</html>
""".format(
    title=title,
    pca_html=os.path.basename(pca_html),
    lai_html=os.path.basename(lai_html)
)

    with open(report_file, "w") as fh:
        fh.write(html)

    print(f"Writing report: {report_file}")


def is_valid_matrix(path):
    try:
        df = pd.read_csv(path, sep="\t", nrows=1)
        return df.shape[1] >= 3
    except Exception:
        return False


def main():

    args = set_up_parser().parse_args()

    base_dir = os.path.dirname(
        os.path.realpath(__file__)
    )

    model_dir = os.path.join(
        base_dir,
        "model"
    )

    default_ref_models = {
        45: os.path.join(
            model_dir,
            "korusModelMatrixk45.tsv.gz"
        ),
        55: os.path.join(
            model_dir,
            "korusModelMatrixk55.tsv.gz"
        )
    }

    default_labels = os.path.join(
        model_dir,
        "korusModelLabels.tsv.gz"
    )

    default_fractions = os.path.join(
        model_dir,
        "korusModelLabelsFractions.tsv.gz"
    )

    ref_model = (
        args.ref
        if args.ref
        else default_ref_models[args.k]
    )

    label_file = (
        args.labels
        if args.labels
        else default_labels
    )

    fraction_file = (
        args.fractions
        if args.fractions
        else default_fractions
    )

    if not os.path.isfile(ref_model):

        raise FileNotFoundError(
            f"Reference model not found: {ref_model}"
        )

    if args.mode == "hard":
  
        if not os.path.isfile(label_file):

            raise FileNotFoundError(
                f"Labels file not found: {label_file}"
            )

    if args.mode == "soft":

        if not os.path.isfile(fraction_file):

            raise FileNotFoundError(
                f"Fractions file not found: {fraction_file}"
            )

    # --------------------------------------------------
    # Encode
    # --------------------------------------------------

    reads_prefix = os.path.basename(
        args.reads
    )

    matrix_file = (
        f"{reads_prefix}"
        f"_k{args.k}"
        f"_t{args.tile}"
        f"_korus-matrix.tsv"
    )

    matrix_file = os.path.abspath(matrix_file)

    if os.path.isfile(matrix_file) and is_valid_matrix(matrix_file):
        print(f"[checkpoint] Valid matrix found: {matrix_file}")
        print("[checkpoint] Skipping korusEncode step")
    else:
        print("[checkpoint] Matrix missing or invalid, running encode")
        encode_cmd = (
            f"korusEncode "
            f"--reads {args.reads} "
            f"--kmer_file {args.kmer_file} "
            f"-k {args.k} "
            f"--tile {args.tile} "
            f"-t {args.t}"
        )

        run_command(encode_cmd, args.dry_run)

    matrix_df = pd.read_csv(
        matrix_file,
        sep="\t",
        nrows=0
    )

    query_samples = matrix_df.columns[2:]

    if len(query_samples) != 1:

        raise RuntimeError(
            "korus pipeline is intended for a single query sample.\n"
            f"Detected {len(query_samples)} samples:\n"
            + "\n".join(query_samples) +
            "\n\nUse korusDecode.py directly for multi-sample analyses."
        )

    sample_name = query_samples[0]

    if args.report_title == "KORUS Analysis Report":

        args.report_title = (
           f"KORUS ancestry report: {sample_name}"
        )

    # --------------------------------------------------
    # Decode
    # --------------------------------------------------

    decode_cmd = (
        f"korusDecode.py "
        f"--ref {ref_model} "
        f"--sample {matrix_file} "
        f"--outprefix {args.outprefix} "
        f"--window_radius {args.window_radius} "
        f"--stay_prob {args.stay_prob}"
    )

    if args.mode == "hard":

        decode_cmd += (
            f" --labels {label_file}"
        )

    elif args.mode == "soft":

        decode_cmd += (
            f" --fractions {fraction_file}"
        )

    elif args.mode == "unsupervised":

        clusters = args.c if args.c is not None else 5

        decode_cmd += f" --c {clusters}"


    if args.no_hmm:

        decode_cmd += " --no_hmm"

    run_command(
        decode_cmd,
        args.dry_run
    )

    # --------------------------------------------------
    # Locate PCA html
    # --------------------------------------------------

    if args.mode == "soft":

        pca_html = (
            f"{args.outprefix}.fractions.pca3d.html"
        )

    else:

        pca_html = (
            f"{args.outprefix}.pca3d.html"
        )

    # --------------------------------------------------
    # Locate LAI file
    # --------------------------------------------------

    sample_name = os.path.basename(args.reads)
    lai_tsv = f"{sample_name}_{args.outprefix}.lai.tsv"

    if not os.path.isfile(lai_tsv):
        raise RuntimeError("No LAI TSV produced.")

    lai_html = lai_tsv.replace(
        ".tsv",
        ".html"
    )

    lai_plotter = shutil.which(
        "plot_ntroot_lai.py"
    )

    if lai_plotter is None:

        raise RuntimeError(
            "Could not locate plot_ntroot_lai.py in PATH"
        )

    lai_cmd = (
        f"{lai_plotter} "
        f"{lai_tsv} "
        f"{lai_html} "
        f"KORUS"
     )

    run_command(
        lai_cmd,
        args.dry_run
    )

    # --------------------------------------------------
    # Report
    # --------------------------------------------------

    if not args.dry_run:

        write_report(
            args.outprefix,
            args.report_title,
            pca_html,
            lai_html
        )

        print("\nDone KORUS!")

if __name__ == "__main__":
    main()


