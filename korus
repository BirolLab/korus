        pca_html
    )

    js = r"""
window.addEventListener(
    "load",
    function() {

        const plots =
            document.querySelectorAll(
                ".plotly-graph-div"
            );

        console.log(
            "Detected",
            plots.length,
            "Plotly plots"
        );

        if (plots.length < 2)
            return;

        const laiPlot = plots[0];
        const pcaPlot = plots[1];

        document
            .getElementById("reset-lai-btn")
            .addEventListener(
                "click",
                function() {
                    location.reload();
                }
            );


        function getTraceColor(trace)
        {

            if (
                trace.marker &&
                trace.marker.color
            )
            {
                return trace.marker.color;
            }

            if (
                trace.line &&
                trace.line.color
            )
            {
                return trace.line.color;
            }

            return null;
        }

        function highlightLAIByColor(
            targetColor
        )
        {

           const opacities = [];

           for (let i = 0; i < laiPlot.data.length; i++) {

              const trace = laiPlot.data[i];

              // 1. NEVER touch backbone
              if (isBackboneTrace(trace)) {
                 opacities.push(1.0);
                 continue;
              }

              // 2. NEVER touch boundary separators (your "ticks")
              if (isBackboneSeparator(trace)) {
                  opacities.push(1.0);
                  continue;
              }

              // 3. NEVER touch pie chart
              if (trace.type === "pie") {
                 opacities.push(1.0);
                 continue;
              }

              const traceColor = getTraceColor(trace);

               // 4. only ancestry-like traces participate
              const isAncestryTrace =
              (trace.marker || trace.line) &&
              traceColor !== null;

              if (!isAncestryTrace) {
                 opacities.push(1.0);
                 continue;
              }

              opacities.push(
                 traceColor === targetColor ? 1.0 : 0.05
              );
           }

           Plotly.restyle(
               laiPlot,
               {opacity: opacities}
           );
        }

        function isBackboneTrace(trace) {
           return trace.meta && typeof trace.meta === "string" && trace.meta.startsWith("BACKBONE");
        }
        function isBackboneSeparator(trace) {
           return trace.meta === "BACKBONE_SEPARATOR";
        }

        laiPlot.on("plotly_click", (e) => {
           if (!e.points?.length) resetLAI();
        });

        pcaPlot.on("plotly_legendclick", function(evt) {
           const color = getTraceColor(pcaPlot.data[evt.curveNumber]);
           if (color) highlightLAIByColor(color);
           return true;
        });

        function resetLAI()
        {

            Plotly.restyle(
                laiPlot,
                {
                    opacity:
                        laiPlot.data.map(
                            () => 1.0
                        )
                }
            );

        }

        pcaPlot.on(
            "plotly_hover",
            function(evt)
            {

                console.log(
                    evt.points[0]
                );

                const color =
                    getTraceColor(
                        evt.points[0].data
                    );

                console.log(
                    "hover color:",
                    color
                );

                if (color)
                {
                    highlightLAIByColor(
                        color
                    );
                }

            }
        );

        pcaPlot.on(
            "plotly_unhover",
            function()
            {
                resetLAI();
            }
        );

        pcaPlot.on(
            "plotly_legenddoubleclick",
            function(evt)
            {

                const trace =
                    pcaPlot.data[
                        evt.curveNumber
                    ];

                const color =
                    getTraceColor(
                        trace
                    );

                if (color)
                {
                    highlightLAIByColor(
                        color
                    );
                }

                return false;

            }
        );

    }
);
"""

